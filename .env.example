# Copy this file to .env and fill in your IBM Cloud credentials to enable
# QC_BACKEND_MODE=ibm_runtime (real, cloud hosted quantum execution).
# Never commit the real .env file. It is already listed in .gitignore.
#
# Where to find these values: IBM Cloud console, then your Qiskit Runtime
# service instance, then the "Manage" tab.
#   IBM_QUANTUM_CRN      the instance's Cloud Resource Name (CRN), e.g.
#                        crn:v1:bluemix:public:quantum-computing:...
#   IBM_QUANTUM_API_KEY  an IBM Cloud API key (IBM Cloud console, then
#                        Manage, Access (IAM), API keys, Create).
IBM_QUANTUM_CRN=
IBM_QUANTUM_API_KEY=

# Optional: which execution path main.py and quantum_backend.py use by default.
#   aer_simulator (default), aer_noisy, or ibm_runtime
QC_BACKEND_MODE=aer_simulator
QC_SHOTS=4096
# Optional: pin a specific IBM backend name instead of auto-picking the least busy one.
QC_IBM_BACKEND=

# Optional: manually choose which columns are used as model features,
# instead of the automated selection. Useful after inspecting
# plots/feature_correlation_heatmap.png and picking your own set. Comma
# separated, must be a subset of the 14 RDKit descriptors plus D50 and
# apparent_solubility (see CANDIDATE_FEATURE_COLS in src/config.py). Leave
# empty to keep automated selection. If this list isn't exactly 6 features,
# the QCNN model (which needs exactly 6 qubits) picks its own 6 features
# automatically instead.
# Example: MANUAL_FEATURES=D50,MolLogP,Kappa3,TPSA
MANUAL_FEATURES=

# Optional: hand-pick the QCNN / QCNN-R fixed 6-feature subset (exactly 6
# columns, one per qubit), independently of MANUAL_FEATURES above (which
# covers every other model). Validated the same way: must be a subset of
# CANDIDATE_FEATURE_COLS. Leave empty to keep the automated 6-feature
# selection for the QCNN models.
# Example: MANUAL_FEATURES_QCNN=D50,MolLogP,Kappa3,apparent_solubility,TPSA,Kappa2
MANUAL_FEATURES_QCNN=
