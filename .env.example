# Copy this file to .env and fill in your IBM Cloud credentials to enable
# `QC_BACKEND_MODE=ibm_runtime` (real / cloud-hosted quantum execution).
# Never commit the real .env file -- it is already listed in .gitignore.
#
# Where to find these values: IBM Cloud console -> your Qiskit Runtime
# service instance -> "Manage" tab.
#   IBM_QUANTUM_CRN      = the instance's Cloud Resource Name (CRN), e.g.
#                           crn:v1:bluemix:public:quantum-computing:...
#   IBM_QUANTUM_API_KEY  = an IBM Cloud API key (IBM Cloud console -> Manage
#                           -> Access (IAM) -> API keys -> Create).
IBM_QUANTUM_CRN=
IBM_QUANTUM_API_KEY=

# Optional: which execution path main.py/quantum_backend.py use by default.
#   aer_simulator (default) | aer_noisy | ibm_runtime
QC_BACKEND_MODE=aer_simulator
QC_SHOTS=4096
# Optional: pin a specific IBM backend name instead of auto-picking least-busy.
QC_IBM_BACKEND=

# Optional: manually override which columns are used as model features,
# bypassing the automated PCA-guided SelectKBest sweep -- e.g. after
# inspecting plots/feature_correlation_heatmap.png and picking your own set.
# Comma separated, must be a subset of the 14 RDKit descriptors + D50 +
# apparent_solubility (see src/config.py::CANDIDATE_FEATURE_COLS). Leave
# empty to keep automated selection. If this list isn't exactly 6 features,
# the fixed 6-qubit QCNN falls back to an automated 6-best subset on its own.
# Example: MANUAL_FEATURES=D50,MolLogP,Kappa3,TPSA
MANUAL_FEATURES=
